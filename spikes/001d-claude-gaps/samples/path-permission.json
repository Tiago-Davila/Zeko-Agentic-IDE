{
  "platform": "win32",
  "claudeVersion": "2.1.283",
  "model": "claude-sonnet-5",
  "mode": "restricted",
  "permissionMode": "acceptEdits",
  "allowedTools": [
    "Read",
    "Write(src/**)",
    "Edit(src/**)",
    "Glob",
    "Grep"
